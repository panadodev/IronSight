# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (either key is accepted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ironsight
# POSTGRESQL_URI=postgresql://postgres:postgres@localhost:5432/ironsight

# Redis (either key is accepted)
REDIS_URL=redis://localhost:6379
# REDIS_URI=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-a-long-random-secret
# SESSION_TTL_SECONDS code default is 1,209,600 (14 days); override here if needed
SESSION_TTL_SECONDS=86400
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Public app URL used for OAuth callback generation
APP_URL=http://localhost:3000

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: override the OAuth callback URL. Defaults to ${APP_URL}/api/auth/discord/callback
# DISCORD_REDIRECT_URI=

# Sysadmin identity (required — startup fails without these)
SYS_ADMIN_DISCORD_ID=
SYSADMIN_STEAM_ID=

# Steam OpenID (optional overrides — defaults derived from APP_URL)
# STEAM_REALM=
# STEAM_RETURN_URL=

# PostgreSQL pooling
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=5000

# Pterodactyl panel integration
# PTERODACTYL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Discord bot (required for bot.js / Discord Gateway features)
# DISCORD_BOT_TOKEN=

# Cloudflare R2 (required for media uploads — staff attachments, ticket media)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# External API keys (BattleMetrics, Steam, Proxycheck) are configured
# per-organisation through the panel UI (Manage → Integrations).
# Multiple keys per service are supported with automatic rotation and
# per-key rate-limit backoff. No env vars needed for these.

# Optional: verify Proxycheck response signatures (HMAC-SHA256)
# PROXYCHECK_HMAC_KEY=
# Optional: fallback Proxycheck API key (per-org panel UI keys take priority)
# PROXYCHECK_API_KEY=

# BattleMetrics API relays — set to "true" only in local dev to allow http://
# RELAY_ALLOW_INSECURE=
